---
/*
 * A small picture of a collection's map page, for the link to it on the landing page: the same layout as the map
 * (src/lib/mandala.mjs), with the cover as a plain card, each guide as a tile in its group's colour (filled,
 * outlined for a draft, faint for a coming guide) and each title as a grey bar. Decoration for the link beside it.
 */
import type { Collection } from "../lib/guides";
import { layout, WIDTH } from "../lib/mandala.mjs";

interface Props {
  map: NonNullable<Collection["map"]>;
}

const { map } = Astro.props;
const groups = map.groups.map((group) => ({
  colour: group.colour,
  rows: group.entries.map(({ guide, coming }) =>
    guide
      ? { title: guide.title, state: guide.status === "draft" ? "draft" : "finished" }
      : { title: coming.title, state: "coming" },
  ),
}));
const plan = layout(groups.map((group) => group.rows.map((row) => row.title)));
const TILE = 28;
const ROW = 40;
const NAME = 44;
// A grey bar as long as the title, roughly.
const bar = (title: string) => Math.min(150, 40 + title.length * 3.4);
---

<svg class="mini" viewBox={`0 0 ${WIDTH} ${plan.height}`} aria-hidden="true" focusable="false">
  {
    plan.groups.map((spot) => (
      <>
        <path class="mini-link" d={spot.link} />
      </>
    ))
  }
  <rect class="mini-cover" x={plan.cover.x} y={plan.cover.y} width={plan.cover.width} height={plan.cover.height} />
  {
    plan.groups.map((spot, index) => {
      const sign = spot.side === "left" ? -1 : 1;
      const group = groups[index];
      return (
        <g style={`--tile: ${group.colour.base}; --band: ${group.colour.band}`}>
          <rect
            class="mini-bar name"
            x={sign < 0 ? spot.x - 110 : spot.x}
            y={spot.y - 6}
            width="110"
            height="12"
          />
          {group.rows.map((row, i) => {
            const y = spot.y + NAME / 2 + i * ROW;
            const tileX = sign < 0 ? spot.x - TILE : spot.x;
            const length = bar(row.title);
            const barX = sign < 0 ? tileX - 14 - length : tileX + TILE + 14;
            return (
              <>
                <rect class:list={["mini-tile", row.state]} x={tileX} y={y} width={TILE} height={TILE} />
                <rect class:list={["mini-bar", row.state]} x={barX} y={y + 8} width={length} height="12" />
              </>
            );
          })}
        </g>
      );
    })
  }
</svg>

<style>
  /* Fills its box, keeping its proportions. */
  .mini {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mini-link {
    fill: none;
    stroke: var(--faint);
    stroke-width: 4;
  }
  .mini-cover {
    fill: #fff;
    stroke: var(--border);
    stroke-width: 3;
  }
  .mini-tile {
    fill: var(--tile);
  }
  .mini-tile.draft {
    fill: none;
    stroke: var(--band);
    stroke-width: 5;
  }
  .mini-tile.coming {
    fill: none;
    stroke: var(--faint);
    stroke-width: 3;
    stroke-dasharray: 6 5;
  }
  .mini-bar {
    fill: var(--faint);
  }
  .mini-bar.name {
    fill: var(--muted);
  }
  .mini-bar.coming {
    opacity: 0.5;
  }
</style>
