---
/*
 * "Leave a star": a link to the repository on GitHub. Used in the header and footer of the site's own pages
 * (src/layouts/Plain.astro) and at the foot of every guide's page (src/components/starlight/Footer.astro).
 *
 * Without JavaScript it is a plain link that opens the repository in a new tab. With it, a click opens the
 * repository in a small window over the page, so the guide stays where it was. If the browser blocks the window,
 * the link opens a new tab as usual.
 *
 * look: "button" is a .btn (brand.css), "link" a plain text link that takes the colours around it, and
 * "starlight" a small bordered link in Starlight's colours.
 */
interface Props {
  look: "button" | "link" | "starlight";
}

const { look } = Astro.props;
const repo = "https://github.com/stuffbucket/accidental-info";
---

<a
  class:list={[look === "button" ? "btn" : `star-${look}`]}
  href={repo}
  target="_blank"
  rel="noopener"
  aria-label="Leave a star on GitHub"
  data-star-link
>
  Leave a star
</a>

<style>
  .star-link {
    color: inherit;
  }
  .star-starlight {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.2;
    text-decoration: none;
  }
  .star-starlight:hover {
    border-color: var(--sl-color-gray-2);
    color: var(--sl-color-white);
  }
  .star-starlight:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // The window over the page, in CSS pixels; smaller on smaller screens.
  const WIDTH = 960;
  const HEIGHT = 720;

  const links = document.querySelectorAll<HTMLAnchorElement>("a[data-star-link]");

  const open = (link: HTMLAnchorElement, event: MouseEvent) => {
    // Let the browser handle a middle click or a modified click (new tab, new window, download).
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const width = Math.min(WIDTH, screen.availWidth);
    const height = Math.min(HEIGHT, screen.availHeight);
    const left = Math.max(0, window.screenX + (window.outerWidth - width) / 2);
    const top = Math.max(0, window.screenY + (window.outerHeight - height) / 2);
    const features = `popup=yes,width=${width},height=${height},left=${Math.round(left)},top=${Math.round(top)}`;
    // Opened blank first so it can be cut loose from this page, as rel="noopener" does for the link.
    const popup = window.open("", "accidentalguide-star", features);
    if (!popup) return; // Blocked: the link opens a new tab instead.
    event.preventDefault();
    try {
      popup.opener = null;
    } catch {
      // Already showing GitHub from an earlier click.
    }
    popup.location.href = link.href;
    popup.focus();
  };

  links.forEach((link) => link.addEventListener("click", (event) => open(link, event)));
</script>
