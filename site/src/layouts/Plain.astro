---
// Layout of the site's own pages (the landing page, the map page and the list of all guides): a slim header, the
// guides' look, the light or dark theme the visitor picked in the docs, and a footer with who makes the guides, the
// address to write to, the licenses, the source and "Leave a star".
import "../styles/brand.css";
import StarLink from "../components/StarLink.astro";

interface Props {
  title: string;
  description: string;
  // The share image, a path under the base (1200 x 630), and its alt text.
  image: string;
  imageAlt: string;
}

const { title, description, image, imageAlt } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// Sites that show a link's preview need absolute addresses.
const url = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(`${base}${image}`, Astro.site).href;
const repo = "https://github.com/stuffbucket/accidentalguide";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en" />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Accidental Guides" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      // Starlight keeps the docs' theme choice here; "" or nothing means "follow the system".
      try {
        const theme = localStorage.getItem("starlight-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>Accidental Guides</a>
      <nav aria-label="Site">
        <a href={`${base}guides/`}>All guides</a>
        <StarLink look="link" />
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <p>A person writes and reviews every guide. AI does the grunt work.</p>
      <p class="links">
        <a href="mailto:hi@accidental.info">hi@accidental.info</a>
        <a href={repo}>Source on GitHub</a>
        <StarLink look="link" />
      </p>
      <p>
        The guides’ text is under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>, the code
        under the <a href={`${repo}/blob/main/LICENSE`}>MIT License</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    display: grid;
    gap: 0.4rem;
    width: min(100% - 2 * var(--gutter), var(--page));
    margin: 0 auto;
    padding: 1.25rem 0 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  .site-footer a {
    color: var(--muted);
  }
</style>
