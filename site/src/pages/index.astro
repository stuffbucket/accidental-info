---
// The landing page: a short title and the collections' tiles, then each collection as a shelf of covers.
// Accidental Intelligence shows its finished guides and a small picture of its map page, linked; the others show
// every guide they have, drafts included, and a blank grey sheet for each guide still to come. Two collections share
// a row unless one has more than four books. The full list with versions and files is on /guides/.
import Plain from "../layouts/Plain.astro";
import Tile from "../components/Tile.astro";
import MiniMap from "../components/MiniMap.astro";
import { base, loadCollections, repo } from "../lib/guides";

const collections = loadCollections().map((collection) => {
  // A collection with a map shows only its finished guides here; the rest are on its page.
  const mapped = collection.map !== null;
  const shelf = mapped
    ? collection.entries.filter((entry) => entry.guide && entry.guide.status !== "draft")
    : collection.entries;
  return { ...collection, shelf, wide: shelf.length + (mapped ? 1 : 0) > 4 };
});

const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
// What a tile says under the collection's name, a line each: how many guides it has, and how many are coming.
const tally = (collection: (typeof collections)[number]) =>
  [collection.count && plural(collection.count, "guide"), collection.coming.length && `${collection.coming.length} coming`]
    .filter((line): line is string => Boolean(line));
---

<Plain
  title="Accidental Guides"
  description="My friend has a lot of questions."
  image="social.png"
  imageAlt="The covers of the Accidental Guides"
>
  <main>
    <section class="hero" aria-labelledby="title">
      <div>
        <h1 id="title"><span>Accidental</span> <span>Guides</span></h1>
        <p class="line">My friend has a lot of questions.</p>
      </div>

      <nav class="tiles" aria-label="Collections">
        <ol>
          {
            collections.map((collection, index) => (
              <li>
                <a href={`#${collection.id}`}>
                  <Tile
                    code={collection.code}
                    colour={collection.colour}
                    number={String(index + 1).padStart(2, "0")}
                  />
                  <span class="tile-name">{collection.name}</span>
                  {tally(collection).map((line) => (
                    <span class="small muted">{line}</span>
                  ))}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <div class="collections">
      {
        collections.map((collection) => (
          <section
            class:list={["collection", { wide: collection.wide }]}
            id={collection.id}
            aria-labelledby={`${collection.id}-name`}
            style={`--tile: ${collection.colour.base}`}
          >
            <div class="label">
              <div>
                <h2 id={`${collection.id}-name`}>{collection.name}</h2>
                {collection.line && <p class="muted">{collection.line}</p>}
              </div>
              {collection.image && (
                <img class="art" src={`${base}${collection.image}`} alt={collection.imageAlt} loading="lazy" />
              )}
            </div>

            <ul class="shelf">
              {collection.shelf.map(({ guide, coming }) =>
                guide ? (
                  <li class="book">
                    <a href={`${base}${guide.page}`}>
                      <img
                        class="cover"
                        src={`${base}guides/${guide.id}/cover.png`}
                        alt=""
                        width={guide.cover.width}
                        height={guide.cover.height}
                        loading="lazy"
                      />
                      <span class="title">{guide.title}</span>
                    </a>
                    {guide.status === "draft" && <span class="small muted">Draft</span>}
                  </li>
                ) : (
                  <li class="book coming">
                    <span class="cover ghost">{coming.title}</span>
                    <span class="small muted">Coming</span>
                  </li>
                ),
              )}
              {collection.map && (
                <li class="book map">
                  <a href={`${base}${collection.page}`}>
                    <span class="cover plate">
                      <MiniMap map={collection.map} />
                    </span>
                    <span class="title">All {collection.count} guides, on one map</span>
                  </a>
                </li>
              )}
            </ul>
          </section>
        ))
      }

      <section class="write" aria-labelledby="write">
        <h2 id="write">Write your own</h2>
        <p class="muted">
          The <a href={`${base}accidental-guide-template.docx`} download>Word template</a> is the guides’ layout, with
          a note in each place saying what goes there. Use it for your own team or class. We publish a few guides from
          other writers, so <a href={`${repo}/blob/main/CONTRIBUTING.md#sending-us-a-guide`}>read how to send one</a
          >{" "}first.
        </p>
      </section>
    </div>
  </main>
</Plain>

<style>
  /* Four sizes: the title, the line under it and the collections' names, body text, and small text. Two weights. */
  main {
    --paper: #f4f4f3;
    /* One grid for the whole page: eight columns on a wide screen, a cover to a column. */
    --gap: clamp(1.25rem, 2.2vw, 2rem);
    width: min(100% - 2 * var(--gutter), var(--page));
    margin: 0 auto;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: var(--text-sm);
  }
  p {
    margin: 0;
  }

  /* The title, set like a guide's cover title, and the collections' tiles, like the part tiles under it. */
  .hero {
    padding: clamp(3rem, 8vw, 6rem) 0 clamp(3.5rem, 8vw, 6.5rem);
  }
  h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(3.25rem, 9vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }
  h1 span {
    display: block;
  }
  .line {
    max-width: 22em;
    margin: 0 0 clamp(2.5rem, 6vw, 3.5rem);
    font-size: 1.25rem;
    line-height: 1.35;
  }
  /* Four tiles across the page's eight columns, each starting on a cover's column. */
  .tiles ol {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tiles a {
    display: grid;
    justify-items: start;
    gap: 0.1rem;
    text-decoration: none;
  }
  .tiles a :global(.tile) {
    margin-bottom: 0.6rem;
  }
  .tile-name {
    font-weight: bold;
    line-height: 1.3;
  }
  .tiles a:hover .tile-name,
  .book a:hover .title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  /* The collections, two to a row like shelves in a bookcase; one with more than four books takes the row. The
     gap between them is the gap between covers, so every cover sits on the same eight columns. Each opens with a
     band of its colour. */
  .collections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3.5rem, 7vw, 5.5rem) var(--gap);
  }
  .collection,
  .write {
    border-top: 0.375rem solid var(--tile);
    padding-top: 1.25rem;
    scroll-margin-top: 1.5rem;
  }
  .write {
    --tile: var(--text);
  }
  .wide {
    grid-column: 1 / -1;
  }
  .label {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    margin: 0 0 1.5rem;
  }
  h2 {
    margin: 0 0 0.3rem;
    font-size: 1.25rem;
    line-height: 1.25;
  }
  /* The collection's illustration, when "image" is set in collections.json (none is yet). */
  .art {
    display: block;
    flex: none;
    width: auto;
    max-width: 40%;
    height: 6rem;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  /* The shelf: four books to a half row, eight to a whole one, so every cover is the same size. */
  .shelf {
    --cols: 4;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 2rem var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }
  .wide .shelf {
    --cols: 8;
  }
  .book {
    display: grid;
    align-content: start;
    gap: 0.15rem;
    min-width: 0;
  }
  .book a {
    display: grid;
    gap: 0.15rem;
    text-decoration: none;
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 324 / 540;
    margin-bottom: 0.7rem;
    background: #fff;
    /* A white sheet needs an edge on a white page; a faint one, flat. */
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.1);
  }
  .title {
    font-size: var(--text-sm);
    font-weight: bold;
    line-height: 1.3;
  }

  /* A guide still to come: a blank grey sheet, its title in grey where a cover's title goes. */
  .ghost {
    padding: 18% 13%;
    background: var(--paper);
    box-shadow: none;
    color: var(--muted);
    font-size: 10cqi;
    font-weight: bold;
    line-height: 1.12;
  }
  .coming {
    container-type: inline-size;
  }

  /* The link to the map page: a small picture of the map on a grey plate, two books wide and one tall. */
  .map {
    grid-column: span 2;
  }
  .plate {
    display: block;
    height: calc((100cqi - (var(--cols) - 1) * var(--gap)) / var(--cols) * 540 / 324);
    aspect-ratio: auto;
    padding: 4% 5%;
    background: var(--accent-soft);
    box-shadow: none;
  }

  .write {
    align-self: start;
  }
  .write p {
    max-width: 32rem;
  }
  .write h2 {
    margin-bottom: 0.6rem;
  }
  .write a {
    color: var(--text);
  }

  /* On a wide screen the title takes the first four columns and the tiles the last four, one to a column. */
  @media (min-width: 72rem) {
    .hero {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: end;
      column-gap: var(--gap);
    }
    .line {
      margin-bottom: 0;
    }
    .tiles ol {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--gap);
    }
  }

  @media (max-width: 52rem) {
    .collections {
      grid-template-columns: minmax(0, 1fr);
    }
    .shelf,
    .wide .shelf {
      --cols: 5;
    }
  }

  /* On a phone: the tiles two by two, and three books to a shelf. */
  @media (max-width: 40rem) {
    .tiles ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 1rem;
    }
    .tiles a :global(.tile) {
      --size: 4rem;
    }
    .label {
      margin-bottom: 1.25rem;
    }
    .shelf,
    .wide .shelf {
      --cols: 3;
      row-gap: 1.5rem;
    }
    .ghost {
      padding: 16% 11%;
      font-size: 11cqi;
    }
    .map {
      grid-column: 1 / -1;
    }
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) main {
      --paper: #1f1f1f;
    }
    :root:not([data-theme="light"]) .art {
      filter: invert(0.92);
      mix-blend-mode: screen;
    }
  }
  :root[data-theme="dark"] main {
    --paper: #1f1f1f;
  }
  :root[data-theme="dark"] .art {
    filter: invert(0.92);
    mix-blend-mode: screen;
  }
</style>
