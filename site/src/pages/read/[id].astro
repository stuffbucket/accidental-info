---
// A guide's reader: the PDF's pages along the window's longer side, painted from the PDF so they stay sharp at any
// zoom (src/lib/reader/engine.ts). The pages fill the whole window and the chrome floats over them
// (components/reader/ReaderChrome.astro, styles/reader.css). Without JavaScript, or if PDF.js fails, the pages'
// images (public/guides/<id>/page-01.webp, ..., from scripts/guide_pages.py) stay as a plain list.
import Plain from "../../layouts/Plain.astro";
import ReaderChrome from "../../components/reader/ReaderChrome.astro";
import "../../styles/reader.css";
import { base, loadGuides, type Guide } from "../../lib/guides";

export function getStaticPaths() {
  return loadGuides().map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const pages = Array.from({ length: guide.pages }, (_, i) => i + 1);
const pageDir = `${base}guides/${guide.id}/`;
const file = (n: number) => `${pageDir}page-${String(n).padStart(2, "0")}.webp`;
---

<Plain
  title={`${guide.title} · Accidental Guides`}
  description={guide.subtitle}
  image={`guides/${guide.id}/card.png`}
  imageAlt={`The cover of ${guide.title}`}
  footer={false}
>
  <main
    class="reader reader-viewport"
    id="reader"
    aria-label={`${guide.title}, ${guide.pages} pages`}
    data-pdf={`${base}guides/${guide.pdf}`}
    data-pages={guide.pages}
    data-aspect={guide.cover.width / guide.cover.height}
    data-page-dir={pageDir}
    data-home={base}
  >
    <div class="reader-fallback">
      {
        pages.map((n) => (
          <img
            id={`page-${n}`}
            src={file(n)}
            alt={`Page ${n} of ${guide.pages}`}
            width={guide.cover.width}
            height={guide.cover.height}
            loading={n <= 2 ? "eager" : "lazy"}
            decoding="async"
          />
        ))
      }
    </div>
  </main>
  <ReaderChrome guide={guide} />
</Plain>

<script>
  import { mountReader, type Reader } from "../../lib/reader/engine";

  const viewport = document.getElementById("reader")!;
  const { pdf, pages, aspect, pageDir } = viewport.dataset;
  let reader: Reader | null = null;
  try {
    reader = mountReader(viewport, {
      url: pdf!,
      pageCount: Number(pages),
      pageAspect: Number(aspect),
      placeholder: (n) => `${pageDir}page-${String(n).padStart(2, "0")}.webp`,
    });
  } catch (err) {
    // The plain list of page images stays.
    console.error("reader: could not start", err);
  }

  if (reader) {
    const r = reader;
    const actions: Record<string, () => void> = {
      "zoom-in": () => r.zoomIn(),
      "zoom-out": () => r.zoomOut(),
      fit: () => r.fit(),
      prev: () => r.prev(),
      next: () => r.next(),
      layout: () => r.setLayout(r.layout === "horizontal" ? "vertical" : "horizontal", { animate: true }),
      // Back where the visitor came from on this site, or else the home page.
      back: () => {
        let sameSite = false;
        try {
          sameSite = !!document.referrer && new URL(document.referrer).origin === location.origin;
        } catch {}
        if (sameSite && history.length > 1) history.back();
        else location.href = viewport.dataset.home!;
      },
    };
    document.addEventListener("click", (e) => {
      const button = (e.target as Element | null)?.closest<HTMLElement>("[data-reader-action]");
      const act = button && actions[button.dataset.readerAction ?? ""];
      if (act) {
        e.preventDefault();
        act();
      }
    });
    const pageOut = document.querySelectorAll<HTMLElement>("[data-reader-page]");
    const zoomOut = document.querySelectorAll<HTMLElement>("[data-reader-zoom]");
    const showPage = () => pageOut.forEach((el) => (el.textContent = `${r.page} / ${r.pageCount}`));
    const showZoom = () => zoomOut.forEach((el) => (el.textContent = `${Math.round(r.zoom * 100)}%`));
    r.on("page", showPage);
    r.on("zoom", showZoom);
    showPage();
    showZoom();
    // For tests and the console.
    (window as any).reader = r;
  }
</script>

<style>
  /* The reader fills the window; the site's header gives way to the chrome. */
  :global(.site-header) {
    display: none;
  }
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  .reader {
    position: fixed;
    inset: 0;
    overflow: hidden;
  }
  /* Without the engine: the pages' images, one under the other. */
  .reader-fallback {
    height: 100%;
    overflow: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--reader-gap, 1rem);
    padding: var(--reader-pad, 1rem);
  }
  .reader-fallback[hidden] {
    display: none;
  }
  .reader-fallback img {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    background: #fff;
  }
</style>
