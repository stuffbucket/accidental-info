    "@accidentalguide/copilot-cli": "workspace:*",
    "@accidentalguide/lights-off-software-factories": "workspace:*",
    "@accidentalguide/mcp": "workspace:*",
    "@accidentalguide/pipeline": "workspace:*",
    "@accidentalguide/skills": "workspace:*",
    "@accidentalguide/software-factories": "workspace:*",
    "@accidentalguide/specs-and-reviews": "workspace:*",
