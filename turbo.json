{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalDependencies": [
    "mise.toml",
    "pnpm-workspace.yaml",
    "packages/pipeline/requirements.txt"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ],
      "env": [
        "SITE_ORIGIN",
        "SITE_BASE"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!notes/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
